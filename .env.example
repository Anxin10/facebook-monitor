# Facebook 監控系統 - 環境變數範例
# 請複製此檔案為 .env 並填寫實際值
# 注意：.env 檔案已加入 .gitignore，不會被提交至 Git

# Meta Facebook API 設定
# 請透過 Meta Developers 建立 App 並申請 Page Public Content Access
FACEBOOK_APP_ID="your_app_id"
FACEBOOK_PAGE_ACCESS_TOKEN="your_page_access_token"
FACEBOOK_USER_ACCESS_TOKEN="your_user_access_token"  # 若需要

# LINE Notify 設定（若使用）
LINE_NOTIFY_TOKEN="your_line_notify_token"
LINE_WEBHOOK_URL="your_line_webhook_url"  # 若使用 Webhook

# Telegram 設定（若使用）
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Email 設定（若使用）
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_USER="your_email@gmail.com"
EMAIL_PASSWORD="your_app_password"
EMAIL_FROM="your_email@gmail.com"
EMAIL_TO="recipient@example.com"

# 瀏覽器設定（若使用 Playwright 讀取限動）
# PLAYWRIGHT_BROWSER="chromium"  # chromium | firefox | webkit
# PLAYWRIGHT_HEADLESS=true  # 無頭模式執行

# 日誌等級（可覆寫 config.yaml）
# LOG_LEVEL="DEBUG"
