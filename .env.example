# Facebook 監控系統環境變數範例
# 複製此檔案為 .env 並填入實際值
# 切勿提交包含真實憑證的 .env 檔案

# Facebook Graph API 存取權杖
# 需具有讀取粉專貼文的資格
FACEBOOK_ACCESS_TOKEN=填入具有必要讀取資格的 Token

# Telegram 通知（Apprise 格式）
# 格式：tgram://BOT_TOKEN/CHAT_ID
TELEGRAM_APPRISE_URL=tgram://BOT_TOKEN/CHAT_ID

# Email 通知（Apprise 格式）
# 格式：mailto://USER:PASSWORD@example.com
# 特殊字元須 URL encode
EMAIL_APPRISE_URL=mailto://USER:PASSWORD@example.com

# LINE Messaging API
# Channel Access Token
LINE_CHANNEL_ACCESS_TOKEN=填入 LINE 頻道存取權杖
# 接收者 User ID
LINE_TO=填入接收者 ID
